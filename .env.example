# API keys (any one is enough to start)
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
# FORGE_API_KEY=          # generic / custom provider

# Optional overrides
FORGE_HOME=               # default ~/.forge
# GROK_HOME=              # default ~/.grok (for forge login --from-grok)
FORGE_MODEL=
FORGE_PROVIDER=           # xai|anthropic|openai|openrouter|google|custom (claude|gpt|oai|gemini|…)
FORGE_BASE_URL=
FORGE_EFFORT=             # low|medium|high (hi|lo|med|max; alias: FORGE_REASONING_EFFORT)
FORGE_PERMISSION_MODE=    # default|acceptEdits|plan|bypassPermissions|dontAsk (accept|deny|ask|yolo)
FORGE_SANDBOX=            # off|workspace|read-only|strict (readonly|ro|ws|none|full)
FORGE_SANDBOX_NETWORK=    # unrestricted|blocked
FORGE_SANDBOX_MISSING_BACKEND=  # fail-closed|fallback
FORGE_READ_OUTSIDE=       # ask|allow|deny
FORGE_BLOCKING_STOP=      # 0 to disable blocking Stop (Grok-compatible)
FORGE_HEADLESS=1          # force headless single-shot even on a TTY
FORGE_LOG_LEVEL=          # debug|info|warn|error
FORGE_LOG_JSON=1          # structured JSON logs on stderr (CI)
FORGE_JSON_COMPACT=1      # single-line --json success payloads (CI log aggregation)

# Production reliability
FORGE_PROVIDER_TIMEOUT_MS=10m      # stall silence per provider call (ms or 10m; default 10m; min 5s). Resets on each stream chunk — not a total wall-clock kill for healthy long generations
# FORGE_PROVIDER_MAX_MS=2h         # optional absolute wall-clock ceiling (off by default); stall resets do not extend this
FORGE_BASH_TIMEOUT_MS=2m           # default foreground bash timeout (ms or 90s/2m; min 5s, max 30m)
FORGE_BASH_BG_TIMEOUT_MS=1800000    # default background task timeout (min 30s, max 6h)
FORGE_MAX_TURNS=                   # optional agent turn cap (0 = unlimited)
FORGE_MAX_RUN_MS=                  # optional headless wall-clock deadline (ms or 30m; min 5s; exit 124)
FORGE_PERMISSION_TIMEOUT_MS=       # interactive Allow? auto-deny (min 5s when set; 0/unset = wait forever)
FORGE_DOOM_LOOP_THRESHOLD=3        # identical tool+args streak before strategy nudge
FORGE_ERROR_STREAK_THRESHOLD=5     # consecutive tool errors before circuit-breaker nudge
FORGE_ULW_MAX_CONTINUES=200        # Stop-continue cap under ULW
FORGE_ULW_STUCK_THRESHOLD=
FORGE_ADAPTIVE_EFFORT=             # 0 = disable one-notch reasoning escalation on hard rounds
FORGE_TOOL_CLEAR=                  # 0 = disable proactive stale tool-result clearing (microcompaction)
FORGE_TOOL_CLEAR_KEEP_RECENT=10    # hot tail: most recent non-system messages never cleared
FORGE_TOOL_CLEAR_MIN_CHARS=1200    # only tool bodies larger than this are cleared
FORGE_TOOL_CLEAR_MIN_STALE_BYTES=12000  # minimum net chars a clearing pass must free
FORGE_TOOL_CLEAR_EVERY_TURNS=4     # minimum turns between clearing passes
FORGE_ANTHROPIC_CACHE=             # 0 = disable Anthropic cache_control breakpoints
FORGE_GOAL_GATE=
FORGE_GOAL_STUCK_THRESHOLD=
FORGE_BELL=                        # 1/0 force turn-end terminal BEL (overrides /bell preference)
FORGE_NO_AUTO_RESUME=              # 1 = always start a fresh REPL session (skip same-cwd resume)
FORGE_FORCE_SESSION_LOCK=          # 1 = headless forge run may force-steal / continue on foreign live lock

# OAuth client ids (only if you register your own apps)
# FORGE_XAI_CLIENT_ID=
# FORGE_OPENAI_CLIENT_ID=
# FORGE_DEVICE_AUTH_URL=

# Opt-in format-on-write after file tools (prettier/biome/ruff/gofmt/rustfmt)
# FORGE_FORMAT_ON_WRITE=1
# ask_user timeout (ms); default 300000
# FORGE_ASK_USER_TIMEOUT_MS=300000
